{
  "name": "@stoa/cli",
  "version": "0.1.0",
  "description": "Stoa CLI — run any Stoa skill from the terminal.",
  "type": "module",
  "bin": {
    "stoa": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stoa": "tsx src/cli.ts"
  },
  "dependencies": {
    "@stoa/skills": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
