# --- @stoa/web environment ---
# Copy to .env.local and fill after deploying the contracts.

# Public RPC (read-only routes + wallet balance)
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com/

# Server-side addresses (used by /api/services, /api/agents, /api/contracts)
STOA_REGISTRY_ADDRESS=0x...
STOA_SERVICES_ADDRESS=0x...

# Client-exposed addresses (used by /register, /connect — must be NEXT_PUBLIC_*)
NEXT_PUBLIC_STOA_REGISTRY_ADDRESS=0x...
NEXT_PUBLIC_STOA_SERVICES_ADDRESS=0x...

# x402 paid API route (/api/x402/weather) receiving address
X402_PAY_TO=0x...

# Optional: a key for the skill playground (only stateless/read skills run; key is unused by them)
# STOA_PRIVATE_KEY=0x...
