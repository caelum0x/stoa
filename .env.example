# --- Stoa environment ---
# Agent signing key (testnet only — never commit a funded mainnet key)
STOA_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Pharos Atlantic Testnet RPC (chain id 688689)
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com/

# Deployed Stoa contract addresses (fill after `pnpm contracts:deploy`)
STOA_REGISTRY_ADDRESS=0x...
STOA_ESCROW_ADDRESS=0x...

# Test USDC on Atlantic (for x402 / escrow demos)
STOA_TEST_USDC=0xE0BE08c77f415F577A1B3A9aD7a1Df1479564ec8

# Used only by the Foundry deploy script
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
