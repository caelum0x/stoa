# --- Stoa environment ---

# Agent signing key (testnet only — never commit a funded mainnet key)
STOA_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Pharos Atlantic Testnet RPC (chain id 688689)
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com/
STOA_CHAIN_ID=688689

# --- Deployed contract addresses (written by `pnpm deploy:live`) ---
STOA_REGISTRY_ADDRESS=0x...
STOA_ESCROW_ADDRESS=0x...
STOA_SERVICES_ADDRESS=0x...
STOA_SOCIAL_ADDRESS=0x...
STOA_TIPJAR_ADDRESS=0x...
STOA_STREAMING_ADDRESS=0x...
STOA_FAUCET_ADDRESS=0x...
STOA_SESSIONKEYS_ADDRESS=0x...
STOA_SUBSCRIPTIONS_ADDRESS=0x...
STOA_VAULT_ADDRESS=0x...
STOA_ARBITERPANEL_ADDRESS=0x...
STOA_RWA_ADDRESS=0x...
STOA_VALUEREPUTATION_ADDRESS=0x...

# --- Demo: full commerce loop (two funded testnet keys) ---
MERCATOR_BUYER_KEY=0xYOUR_TESTNET_PRIVATE_KEY
MERCATOR_SELLER_KEY=0xANOTHER_TESTNET_PRIVATE_KEY

# --- x402 ---
X402_FACILITATOR_URL=
STOA_TEST_USDC=0xE0BE08c77f415F577A1B3A9aD7a1Df1479564ec8

# --- treasury_guard default policy (optional) ---
STOA_GUARD_MAX_PER_TX=
STOA_GUARD_DAILY_CAP=
STOA_GUARD_ALLOWLIST=

# Used only by the Foundry deploy script
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
